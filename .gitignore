# Build output and packages produced by the orchestrator
out/
dist/

# Local, machine-specific target overrides
targets/*.local.cfg

# Secrets — STT/LLM credentials are read from the environment, never committed
.env

*.log
.DS_Store

# Left behind when dst.py is imported rather than run — the completion and progress
# helpers are exercised that way from tests.
__pycache__/
*.pyc
